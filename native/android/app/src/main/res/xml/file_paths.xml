<?xml version="1.0" encoding="utf-8"?>
<!-- Files the app can hand to another app with a temporary grant:
     - exports/: the Excel backups, PDF reports and calendar files it shares (Drive, WhatsApp...),
     - Pictures/: the temporary file a camera app writes an invoice photo to ("Take a photo"). -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="exports" path="exports/" />
    <external-files-path name="captures" path="Pictures/" />
</paths>
